}

# 8. Jellyseerr Media Requests
http://jellyseerr.ordinateur.local, http://jellyseerr.mediaserver.local {
    reverse_proxy jellyseerr:5055
}

# 9. Prowlarr Indexer Management
http://prowlarr.ordinateur.local, http://prowlarr.mediaserver.local {
    reverse_proxy prowlarr:9696
}

# 10. Bazarr Subtitles Management
http://bazarr.ordinateur.local, http://bazarr.mediaserver.local {
    reverse_proxy bazarr:6767
