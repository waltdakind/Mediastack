# 11. Transmission Torrent Client
http://transmission.ordinateur.local, http://transmission.mediaserver.local {
    @root path /
    redir @root /transmission/web/ 302

    reverse_proxy transmission:9091 {
        header_up X-Transmission-Session-Id {http.request.header.X-Transmission-Session-Id}
    }
}

# 12. TVHeadend Live TV & DVR Backend
http://tvheadend.ordinateur.local, http://tvheadend.mediaserver.local {
    reverse_proxy tvheadend:9981
}

# 13. HDHomeRun Physical Tuner Gateway
http://hdhomerun.ordinateur.local, http://hdhomerun.mediaserver.local {
    reverse_proxy 192.168.4.45:80
}

# 14. Mediastack Database Web GUI
http://db.ordinateur.local, http://db.mediaserver.local {
    reverse_proxy mediastack-db:8080
}
