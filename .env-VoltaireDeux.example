# MediaStack Environment Configuration
# Copy this to .env and customize for your environment

# File Ownership
PUID=1000
PGID=1000

# Timezone
TZ=UTC

# Jellyfin External URL (for remote access)
JELLYFIN_EXTERNAL_URL=http://73.160.54.228:8096

# Syncthing Device Name
SYNCTHING_DEVICE_NAME=VoltaireDeux

# Domain for Caddy (reverse proxy)
# CADDY_DOMAIN=mediastack.example.com

# SMB Shares (optional - only if using remote shares)
# DOWNLOADS_PATH=\\\\host.docker.internal\\Public-Downloads
# VIDEOS_PATH=\\\\host.docker.internal\\Public-Videos
# MUSIC_PATH=\\\\host.docker.internal\\Public-Music

# Docker Registry (if using private registry)
# DOCKER_REGISTRY=registry.example.com

# Backup settings
# BACKUP_RETENTION_DAYS=30
