# 11. Transmission Torrent Client
http://transmission.voltairedeux.local, http://transmission.ordinateur.local, http://transmission.mediaserver.local {
	@root path /
	redir @root /transmission/web/ 302

	reverse_proxy transmission:9091 {
		header_up X-Transmission-Session-Id {http.request.header.X-Transmission-Session-Id}
	}
}

