# ==============================================================================
# MediaStack High-Performance & External WAN Gateway Caddyfile
# Node: VOLTAIREDEUX (192.168.4.30)
# Features: Multi-Domain Routing (voltairedeux.local, ordinateur.local, mediaserver.local)
#           Cross-Node Failover, Zero-Latency Streaming, Full Subdomain Support
# ==============================================================================
{
	auto_https off
}

# 1. Main Dashboard & API Gateway Portal
http://voltairedeux.local, http://ordinateur.local, http://mediaserver.local, http://192.168.4.30, http://localhost, http://127.0.0.1 {
	# Proxy API Gateway routes
	handle /api/* {
		reverse_proxy api-gateway:3000
	}

	handle /mcp/* {
		reverse_proxy api-gateway:3000
	}

	# Guest autologin portal route (bobby / weir)
	handle /autologin {
		rewrite * /autologin.html
		root * /var/www/dashboard
		file_server
	}

	handle /guest {
		rewrite * /autologin.html
		root * /var/www/dashboard
		file_server
	}

	# Control Panel UI
	handle {
		root * /var/www/dashboard
		file_server
	}
}

# 2. Standalone API Gateway Service
http://api.voltairedeux.local, http://api.ordinateur.local, http://api.mediaserver.local {
	reverse_proxy api-gateway:3000
}

# 3. Homepage (GetHomepage) with Upstream Host Header
http://homepage.voltairedeux.local, http://homepage.ordinateur.local, http://homepage.mediaserver.local {
	reverse_proxy homepage:3000 {
		header_up Host {upstream_hostport}
	}
}

# 4. Jellyfin High-Performance Media & Music Streaming (w/ Cross-Node Failover)
http://jellyfin.voltairedeux.local, http://jellyfin.ordinateur.local, http://jellyfin.mediaserver.local {
	# Real-time streaming headers & WebSocket support
	reverse_proxy jellyfin:8096 192.168.4.21:8096 {
		lb_policy first
		fail_duration 10s
		flush_interval -1

		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up Upgrade {http.request.header.Upgrade}
		header_up Connection {http.request.header.Connection}
	}
}

# 5. MusicBrainz & Picard WebService API (w/ Cross-Node Failover to Port 5000)
http://musicbrainz.voltairedeux.local, http://musicbrainz.voltaireun.local, http://musicbrainz.ordinateur.local, http://musicbrainz.mediaserver.local {
	# Allow remote Picard tagging lookups from any network client
	@options {
		method OPTIONS
	}
	handle @options {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "*"
		respond "" 204
	}

	reverse_proxy musicbrainz-docker-musicbrainz-1:5000 host.docker.internal:5001 192.168.4.21:5000 192.168.4.30:5001 {
		lb_policy first
		fail_duration 10s
		flush_interval -1

		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up Authorization {http.request.header.Authorization}
		header_down Access-Control-Allow-Origin "*"
	}
}

