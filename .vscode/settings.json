{
    "files.associations": {
        "Caddyfile": "caddyfile",
        "Caddyfile*": "caddyfile",
        "*Caddyfile*": "caddyfile",
        "*.R": "r",
        "*.r": "r",
        ".Rprofile": "r",
        ".Renviron": "r"
    },
    "powershell.scriptAnalysis.enable": true,
    "r.sessionWatcher": false,
    "python.terminal.activateEnvironment": false,
    "terminal.integrated.environmentChangesIndicator": "off",
    "powershell.integratedConsole.showOnStartup": false
}
