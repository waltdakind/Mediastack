    import security_headers
    encode gzip zstd

    handle /api/* {
        reverse_proxy api-gateway:3000
    }

    handle /autologin* {
        rewrite * /autologin.html
        root * /var/www/dashboard
        file_server
    }

    handle /guest* {
        rewrite * /autologin.html
        root * /var/www/dashboard
        file_server
    }

    handle /listen* {
        rewrite * /autologin.html
        root * /var/www/dashboard
        file_server
    }

    handle {
        root * /var/www/dashboard
        file_server
    }
}

