# =============================================================================
# MediaStack Environment Configuration - Raspberry Pi / Linux ARM Satellite
# =============================================================================

# File Ownership & Timezone
PUID=1000
PGID=1000
TZ=America/New_York

# Public DDNS & Local Hostnames
PUBLIC_DOMAIN=waltdakind.xubi.org
LAN_DOMAIN=raspi.local

# Device & Architecture Identification
ARM_DEVICE_NAME=RASPI
SYNCTHING_DEVICE_NAME=RaspberryPi
ARCH_PROFILE=arm

# Linux / Pi Storage & Config Paths
CONFIG_ROOT=/opt/mediastack/config
CONFIG_DIR=/opt/mediastack/config
MEDIA_ROOT=/mnt/media
MEDIA_DIR=/mnt/media
MUSIC_ROOT=/mnt/media/music
VIDEO_ROOT=/mnt/media/video
TV_ROOT=/mnt/media/tv
LIVESTREAM_ROOT=/mnt/media/livestream
DOWNLOAD_ROOT=/mnt/media/downloads

# Upstream Primary Fleet Host
MAIN_SERVER_HOST=192.168.4.21
SECONDARY_SERVER_HOST=192.168.4.30

# Backup Retention
BACKUP_RETAIN_DAYS=7
