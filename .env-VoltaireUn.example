# =============================================================================
# MediaStack Environment Configuration - VoltaireUn (Primary Node)
# Copy this file to .env and customize for your environment
# =============================================================================

# File Ownership
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Public DDNS Domain & Local LAN Domain
PUBLIC_DOMAIN=waltdakind.xubi.org
LAN_DOMAIN=voltaireun.local

# Jellyfin External URL (for remote access)
JELLYFIN_EXTERNAL_URL=https://jellyfin.waltdakind.xubi.org

# Syncthing / Fleet Device Identification
SYNCTHING_DEVICE_NAME=VoltaireUn
ARM_DEVICE_NAME=VOLTAIREUN
X64_DEVICE_NAME=VOLTAIREUN

# Base Paths (Config & Unified Media)
CONFIG_ROOT=C:\MediastackConfig
CONFIG_DIR=C:\MediastackConfig
MEDIA_ROOT=C:\Users\waltd\OneDrive\Mediastack
MEDIA_DIR=C:\Users\waltd\OneDrive
MUSIC_ROOT=C:\Users\waltd\OneDrive\Mediastack\Music
VIDEO_ROOT=C:\Users\waltd\OneDrive\Mediastack\Videos
TV_ROOT=C:\Users\waltd\OneDrive\Mediastack\TV
LIVESTREAM_ROOT=C:\Users\waltd\OneDrive\Mediastack\LiveStream

# Cluster Hosts
MAIN_SERVER_HOST=192.168.4.21
SECONDARY_SERVER_HOST=192.168.4.30

# Optional Transmission / Servarr Settings
TRANSMISSION_PEER_PORT=51500
BACKUP_RETAIN_DAYS=7
