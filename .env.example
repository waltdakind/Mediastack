# =============================================================================
# MediaStack — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control; it contains secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Host User / Group  (run: id -u && id -g)
# ---------------------------------------------------------------------------
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Timezone  (TZ database name — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# ---------------------------------------------------------------------------
TZ=America/New_York

# ---------------------------------------------------------------------------
# Base paths (all config lives under CONFIG_ROOT, media under MEDIA_ROOT)
# ---------------------------------------------------------------------------
CONFIG_ROOT=/opt/mediastack/config
MEDIA_ROOT=/mnt/media
DOWNLOAD_ROOT=/mnt/media/downloads


# ---------------------------------------------------------------------------
# Backup & Restore
# ---------------------------------------------------------------------------
# How many days of backups to keep (auto-pruned at each startup)
BACKUP_RETAIN_DAYS=7

# ---------------------------------------------------------------------------
# Restore / Import — rebuild a new instance from a previous backup
#
# RESTORE_FROM     : Set to "latest" or a specific snapshot timestamp to
#                    trigger a full config + SQLite import on the next
#                    docker compose up -d.
#                    !! CLEAR THIS to empty after a successful restore !!
#                    (leaving it set causes a restore on every restart)
#
#   Examples:
#     RESTORE_FROM=latest
#     RESTORE_FROM=2026-08-19_13-45-00
#
# RESTORE_SERVICES : Comma-list of services to restore. Default = all.
#   Examples:
#     RESTORE_SERVICES=all
#     RESTORE_SERVICES=jellyfin,radarr,sonarr
#
# AUTO_RESTORE_NEW : Set to true to automatically restore from the newest
#                    backup when CONFIG_ROOT is empty (fresh machine).
# ---------------------------------------------------------------------------
RESTORE_FROM=
RESTORE_SERVICES=all
AUTO_RESTORE_NEW=false
# ---------------------------------------------------------------------------
# Caddy — Reverse Proxy
# Fill in your domain; Caddy auto-provisions TLS via Let`'`s Encrypt.
# Leave blank to fall back to internal HTTP-only mode.
# ---------------------------------------------------------------------------
CADDY_DOMAIN=media.example.com
ACME_EMAIL=you@example.com


# ---------------------------------------------------------------------------
# Prowlarr — API Key (needed for healthcheck; find in Prowlarr Settings ? General)
# Leave as placeholder until first launch generates the key.
# ---------------------------------------------------------------------------
PROWLARR_API_KEY=your_prowlarr_api_key_here
JELLYFIN_MAIN_API_KEY=your_jellyfin_api_key_here
# ---------------------------------------------------------------------------
# Transmission — Torrent Client credentials
# ---------------------------------------------------------------------------
TRANSMISSION_USER=admin
TRANSMISSION_PASS=changeme_strong_password

# ---------------------------------------------------------------------------
# NextPVR — DVR username/password
# ---------------------------------------------------------------------------
NEXTPVR_USER=admin
NEXTPVR_PASS=changeme_strong_password

# ---------------------------------------------------------------------------
# Watchtower — Automatic update schedule (cron syntax)
# Default: every day at 04:00 AM
# ---------------------------------------------------------------------------
WATCHTOWER_SCHEDULE=0 0 4 * * *

